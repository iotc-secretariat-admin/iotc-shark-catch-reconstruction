# Keep raw IOTC source data
# Raw IOTC data
# RC is retained in the repository.
# Large CA and EF source files must be obtained separately.

# Ignore generated/intermediate data by default
# data/*
# # Large CA and EF source files must be obtained separately.
data/raw/ca/*.csv
data/raw/ef/*.csv

# Keep RC source data
!data/raw/rc/
!data/raw/rc/*.csv

# Reproducible intermediate R objects
outputs/**/*.rds

  

# Large intermediate data
data/interim/*
data/processed/*

# Keep directory structure
!data/raw/rc/.gitkeep
!data/raw/ca/.gitkeep
!data/raw/ef/.gitkeep
!data/raw/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

